  "UA20BT/BCV-1-012": {
    "number": "UA20BT/BCV-1-012",
    "nameZh": "巴妮莎·艾诺特卡",
    "effectZh": "[登场时]\n从自己的场外将拥有「黑之暴牛」特征的紫色角色卡 1 张（必要能量为 2 以下）以横置状态登场到场上，或加入雷队。如果场上的其他［特征：黑之暴牛］有 6 张以上，则变为（必要能量为 4 以下）。",
    "triggerZh": "",
    "model": "qwen3.5:4b",
    "translatedAt": "2026-07-14T18:41:12.500Z"
  },
  "UA20BT/BCV-1-011": {
    "number": "UA20BT/BCV-1-011",
    "nameZh": "诺艾尔·西尔瓦",
    "effectZh": "[登场时]\n从自己的牌库上方翻开 4 张卡。从中公开至多 1 张［特征：黑之暴牛］并加入手札，其余的按任意顺序置于自己牌库下方。若将卡加入手札，则将自己的一张手札放置于场外。",
    "triggerZh": "",
    "model": "qwen3.5:4b",
    "translatedAt": "2026-07-14T18:40:54.873Z"
  },
  "UA20BT/BCV-1-013": {
    "number": "UA20BT/BCV-1-013",
    "nameZh": "菲纳尔·鲁拉凯斯",
    "effectZh": "[登场时]\n将必要的能量为 1 以下的自己场上的其他角色卡 1 张回到手牌。如果无法这样做，则将此角色卡回到手牌。",
    "triggerZh": "",
    "model": "qwen3.5:4b",
    "translatedAt": "2026-07-14T18:41:12.502Z"
  },
